rules_version = '2';

// PET-Saúde — protótipo local. Escritas canônicas somente via backend.
// tenants/{tenantId}/vinculos/{uid}: uid, tenantId=municipioId, perfil,
// equipeId?, microareaIds, status ATIVO|INATIVO, versaoAcesso.
// Dados de saúde em tenants/{tenantId}/{familias,domicilios,individuos,
// avaliacoes_risco}; cada documento preserva município/equipe/microárea.
// Claims são emitidas pelo backend e comparadas com vínculo vigente.
// logs_auditoria: município e metadados sem dados clínicos.
// operacoes: recibos de sincronização com uid; sem leitura pública.
// Caminhos legados na raiz e coleções não declaradas: negados.
service cloud.firestore {
  match /databases/{database}/documents {
    function identidadeInstitucional() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^\\s@]+@ufms\\.br$')
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function vinculo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/vinculos/$(request.auth.uid)).data;
    }

    function acessoVigente(tenantId) {
      let c = request.auth.token;
      let v = vinculo(tenantId);
      return identidadeInstitucional()
        && c.tenantId == tenantId && c.municipioId == tenantId
        && v.uid == request.auth.uid && v.tenantId == tenantId
        && v.municipioId == tenantId && v.status == 'ATIVO'
        && c.versaoAcesso == v.versaoAcesso
        && c.perfil == v.perfil
        && c.perfil in ['ACS', 'ENFERMEIRO', 'MEDICO', 'TECNICO_ENFERMAGEM',
          'CIRURGIAO_DENTISTA', 'COORDENADOR_APS', 'ADMIN']
        && (c.perfil in ['ADMIN', 'COORDENADOR_APS']
          || (c.equipeId == v.equipeId && c.equipeId is string && c.equipeId.size() > 0
            && (c.perfil != 'ACS' || (c.microareaIds == v.microareaIds
              && c.microareaIds is list && c.microareaIds.size() > 0))));
    }

    function noTerritorio(tenantId, d) {
      return acessoVigente(tenantId)
        && d.municipioId == tenantId
        && (request.auth.token.perfil == 'COORDENADOR_APS'
          || (request.auth.token.perfil in ['ACS', 'ENFERMEIRO', 'MEDICO',
                'TECNICO_ENFERMAGEM', 'CIRURGIAO_DENTISTA']
            && d.equipeId == request.auth.token.equipeId
            && (request.auth.token.perfil != 'ACS'
              || d.microareaId in request.auth.token.microareaIds)));
    }

    match /tenants/{tenantId} {
      allow read: if acessoVigente(tenantId);
      allow write: if false;

      match /vinculos/{uid} {
        // Listagem e gestão administrativas passam pelas funções auditadas.
        allow get: if acessoVigente(tenantId) && uid == request.auth.uid;
        allow list, write: if false;
      }
      match /microareas/{id} {
        allow read: if acessoVigente(tenantId) && resource.data.municipioId == tenantId;
        allow write: if false;
      }
      match /{colecao}/{id} {
        allow read: if colecao in ['familias', 'domicilios', 'individuos', 'avaliacoes_risco']
          && noTerritorio(tenantId, resource.data);
        allow write: if false;
      }
      match /logs_auditoria/{id} {
        allow read: if acessoVigente(tenantId)
          && request.auth.token.perfil in ['ADMIN', 'COORDENADOR_APS']
          && resource.data.municipioId == tenantId;
        allow write: if false;
      }
      match /operacoes/{id} {
        allow read, write: if false;
      }
    }
  }
}
