# Configurações do Firebase para o PET-Saúde (Coxim e Corumbá)
# Copie para `.env` e preencha com os valores do Console do Firebase
# (Configurações do projeto > Seus apps > SDK do Firebase). Nunca versione o `.env`.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=pet-saude-2026
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
